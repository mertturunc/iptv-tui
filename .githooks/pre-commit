#!/bin/sh
# Pre-commit guardrail: the fast subset of the README Development commands.
# `go test -short ./...` (E2E excluded via testing.Short) runs here; the
# environment-sensitive headless E2E stays in the dedicated macOS CI job.
#
# Exit codes are checked directly, never through a pipe: `cmd | tail`
# returns tail's status and would let a red tree commit.
set -u

unformatted=$(gofmt -l .) || {
	echo "pre-commit: gofmt failed to run"
	exit 1
}
if [ -n "$unformatted" ]; then
	echo "pre-commit: unformatted files (run gofmt -w on them):"
	echo "$unformatted"
	exit 1
fi

go vet ./... || {
	echo "pre-commit: go vet failed"
	exit 1
}

go test -short ./... || {
	echo "pre-commit: tests failed"
	exit 1
}

# vet compiles every package (including main) without emitting binaries,
# so this is also the compile check — and it cannot leave a stray
# ./iptv-tui binary behind the way `go build ./...` does.
echo "pre-commit: fmt + vet + tests clean"
